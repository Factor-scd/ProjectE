{
  "name": "project-e",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker",
    "packages/cli"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "typecheck": "turbo typecheck",
    "cli": "tsx packages/cli/index.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@swc/jest": "^0.2.39",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
